#!/bin/bash
# postinstall — runs as root after .pkg payload is extracted
# The payload already installed /usr/local/bin/nomusic and
# /Library/LaunchAgents/com.isdelnorte.nomusic.plist, so launchd starts NoMusic
# at every user's login. This script only starts it now for whoever is logged in.

LABEL="com.isdelnorte.nomusic"
PLIST="/Library/LaunchAgents/$LABEL.plist"

CONSOLE_USER=$(stat -f "%Su" /dev/console)

# No one logged in (remote/MDM install, login window): it starts at next login.
if [ -z "$CONSOLE_USER" ] || [ "$CONSOLE_USER" = "root" ] || [ "$CONSOLE_USER" = "loginwindow" ]; then
    exit 0
fi

CONSOLE_UID=$(id -u "$CONSOLE_USER")

launchctl bootstrap "gui/$CONSOLE_UID" "$PLIST"

sleep 1
if launchctl print "gui/$CONSOLE_UID/$LABEL" &>/dev/null; then
    exit 0
else
    exit 1
fi
