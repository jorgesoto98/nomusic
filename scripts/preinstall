#!/bin/bash
# preinstall — runs as root before .pkg payload is extracted
# Stops any running NoMusic agent and removes the per-user plist left by 1.0.x
# (which installed into ~/Library/LaunchAgents instead of /Library/LaunchAgents).

LABEL="com.isdelnorte.nomusic"

for HOME_DIR in /Users/*; do
    USER_NAME=$(basename "$HOME_DIR")
    USER_UID=$(id -u "$USER_NAME" 2>/dev/null) || continue
    launchctl bootout "gui/$USER_UID/$LABEL" 2>/dev/null || true
    rm -f "$HOME_DIR/Library/LaunchAgents/$LABEL.plist"
done

exit 0
